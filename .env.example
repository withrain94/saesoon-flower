# 이 파일을 복사해 .env.local 을 만들고 값을 채우세요. (.env.local 은 GitHub에 올라가지 않음)
# Vercel에는 프로젝트 Settings > Environment Variables 에 같은 이름으로 넣고 재배포하세요.

# Supabase 대시보드 > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# 비밀 키 — 절대 공개하거나 채팅·코드에 붙여넣지 마세요
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# 관리자 페이지(/admin)에 들어올 수 있는 이메일 (여러 개면 쉼표로)
ADMIN_EMAILS=owner@example.com

# 새 예약 텔레그램 알림 (둘 다 넣어야 켜짐, 비우면 알림 없음)
# 봇 토큰 — 텔레그램 @BotFather 에서 받음. 비밀 키처럼 공개하지 마세요
TELEGRAM_BOT_TOKEN=1234567890:xxxxxxxx
# 알림 받을 채팅 id (여러 곳이면 쉼표로)
TELEGRAM_CHAT_ID=123456789

# 노션 날짜별 예약 표 (둘 다 넣어야 켜짐) — 입금·결제 확인한 예약을 받는 날짜 페이지 표에 올림
# 노션 연결(integration) 비밀 토큰 — https://www.notion.so/profile/integrations 에서 만듦. 공개하지 마세요
NOTION_TOKEN=ntn_xxxxxxxx
# 날짜별 페이지를 만들 노션 페이지 주소(링크 복사) — 이 페이지를 연결에 공유해야 함
NOTION_PARENT_PAGE_ID=https://www.notion.so/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
