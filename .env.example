# 이 파일을 복사해 .env.local 을 만들고 값을 채우세요. (.env.local 은 GitHub에 올라가지 않음)
# Vercel에는 프로젝트 Settings > Environment Variables 에 같은 이름으로 넣고 재배포하세요.

# Supabase 대시보드 > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# 비밀 키 — 절대 공개하거나 채팅·코드에 붙여넣지 마세요
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# 관리자 페이지(/admin)에 들어올 수 있는 이메일 (여러 개면 쉼표로)
ADMIN_EMAILS=owner@example.com
